# Örnek ayarlar. NOT: Uygulama bu dosyayı otomatik OKUMAZ.
# - Yerel çalıştırmada değişkenleri ortamda tanımlayın, örn. PowerShell:
#     $env:RAG_OLLAMA_HOST = "http://localhost:11434"
# - Docker Compose bu dosyanın .env adlı kopyasını otomatik kullanır.
# Tanımlanmayan değişkenler için app/core/config.py içindeki varsayılanlar geçerlidir.

RAG_OLLAMA_HOST=http://localhost:11434
RAG_LLM_MODEL=qwen3:4b-instruct
RAG_EMBEDDING_DEVICE=cpu
RAG_CHROMA_PATH=data/chroma
RAG_UPLOAD_DIR=data/uploads

# İsteğe bağlı: Hugging Face indirme hız sınırı için ücretsiz erişim anahtarı.
# Gerçek anahtarı yalnızca .env dosyasına yazın; .env git'e girmez.
# HF_TOKEN=
